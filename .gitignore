# ---- Flutter / Dart ----
.dart_tool/
.packages
.pub-cache/
.pub/
build/
# Generiert von `flutter pub get`, sobald ein Plugin im Spiel ist (bei uns
# seit shared_preferences). Enthaelt lokale Pfade in den Pub-Cache und ist
# auf einem anderen Rechner wertlos.
.flutter-plugins-dependencies
# pubspec.lock wird BEWUSST committed: Apps pinnen ihre Abhaengigkeiten,
# damit beide Entwickler identische Versionen bauen.
*.g.dart
*.freezed.dart
*.mocks.dart
coverage/
doc/api/

# ---- Plattform-Buildartefakte ----
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
android/local.properties
android/key.properties
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/ephemeral/
windows/flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
macos/Pods/

# ---- IDE ----
.idea/
*.iml
.vscode/
!.vscode/settings.json
*.swp
.DS_Store
Thumbs.db

# ---- Claude Code: persoenlich, NICHT teilen ----
.claude/settings.local.json
# Enthaelt den absoluten Pfad zum lokalen Flutter-SDK und ist auf einem
# anderen Rechner wertlos -- gleiche Begruendung wie bei
# .flutter-plugins-dependencies.
.claude/launch.json

# ---- Secrets ----
.env
.env.*
!.env.example
*.keystore
*.jks

# ---- Lose Bilder aus dem Arbeitsordner ----
# Screenshots und Entwuerfe, die beim Arbeiten anfallen und niemandem
# gehoeren. PR #26 hat die Bilder aus dem Kampf wieder herausgenommen
# (revert 4dd3469), deshalb liegt hier gerade nichts, was ins Repo muss.
/Icon.png
/image.png
# assets/ bleibt gesperrt -- aber nur der Inhalt, damit assets/abilities/
# spaeter eingecheckt werden kann. Der Ordner steht schon als Kommentar in
# pubspec.yaml und wird von lib/combat/move_icon.dart erwartet.
/assets/*
!/assets/abilities/
