<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ab Android 12 malt das System das Startbild selbst: diese Farbe,
         das Startsymbol in der Mitte. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/leder</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/leder</item>
    </style>
</resources>
