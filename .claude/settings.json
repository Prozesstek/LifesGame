{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart test:*)",
      "Bash(dart run:*)",
      "Bash(dart pub get)",
      "Bash(dart pub add:*)",
      "Bash(dart pub outdated)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get)",
      "Bash(flutter pub add:*)",
      "Bash(flutter pub run build_runner:*)",
      "Bash(flutter doctor:*)",
      "Bash(flutter --version)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git show:*)"
    ]
  }
}
